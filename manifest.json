{
  "manifest_version": 3,
  "name": "Overwatch AI",
  "version": "2.0.0",
  "description": "AI-powered tab distraction blocker powered by TypeSafe Jev System One model.",
  "browser_specific_settings": {
    "gecko": {
      "id": "overwatch-ai@linuxer77.github.io",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "assets/logo.svg"
  },
  "icons": {
    "48": "assets/logo.svg",
    "128": "assets/logo.svg"
  }
}
